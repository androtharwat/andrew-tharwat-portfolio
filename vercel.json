{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/share/:media",
      "destination": "/api/share?media=:media"
    },
    {
      "source": "/join",
      "destination": "/join/index.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/project?slug=:slug"
    }
  ]
}
